# Aegis AI System - Environment Variables Example

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database Configuration (if using local PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/aegis_db

# Redis Configuration (for Celery/Message Queue)
REDIS_URL=redis://localhost:6379/0

# AI Engine Configuration
INSIGHTFACE_MODEL_PATH=models/
MEDIAPIPE_MODEL_PATH=models/

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Mobile App Configuration
API_BASE_URL=http://localhost:8000/api/v1